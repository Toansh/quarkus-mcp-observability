# syntax=docker/dockerfile:1

# --- Build stage: compile + package the Quarkus native executable using Mandrel/GraalVM ---
FROM quay.io/quarkus/ubi-quarkus-mandrel:23.1-java21 AS build
WORKDIR /build
COPY --chown=quarkus:quarkus pom.xml ./
COPY --chown=quarkus:quarkus src/ src/
RUN --mount=type=cache,target=/home/quarkus/.m2 mvn -B -DskipTests -Dnative clean package

# --- Runtime stage: UBI Minimal, non-root. Copy only the native executable ---
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.7 AS runtime
WORKDIR /work/
COPY --from=build /build/target/*-runner /work/application
RUN chown 1001 /work && chmod "g+rwX" /work && chown 1001:root /work

EXPOSE 8080
USER 1001
ENV JAVA_OPTS=""
ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
